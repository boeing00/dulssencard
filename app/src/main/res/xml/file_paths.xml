<?xml version="1.0" encoding="utf-8"?>
<!--
  암호화 백업 파일을 공유 시트로 내보내기 위한 경로.

  내부 저장소(filesDir/exports)만 연다. 예전에는 백업을 외부 저장소에 **평문**으로
  떨궜는데, 그건 SQLCipher·Keystore 로 쌓아 올린 방어를 통째로 우회하는 짓이었다.
  지금은 BackupCrypto 로 봉인한 파일만 여기 놓이고, 사용자가 공유 시트로 고른 앱에만
  일회성 읽기 권한이 넘어간다.
-->
<paths>
    <files-path name="backups" path="exports/" />
</paths>
