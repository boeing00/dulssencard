<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      수집 권한 경계 — 이 앱이 선언하는 민감 권한은 알림 접근 하나뿐이다.

      BIND_NOTIFICATION_LISTENER_SERVICE 로 결제 통지 세 종류를 모두 읽는다:
        · 결제 문자   — 기본 문자 앱이 띄운 알림
        · 카드사 앱 푸시
        · 카카오톡 결제 알림톡

      SMS / 통화기록 권한 그룹(RECEIVE_SMS · READ_SMS)은 선언하지 않는다.
      선언만으로도 Play 의 Permissions Declaration 심사 대상이 되는데,
      알림 접근으로 같은 목적을 달성할 수 있어 "다른 방법이 없을 것" 요건이 성립하지 않는다.
      과거 내역은 캡처 이미지 OCR("이미지에서 불러오기")로 채운다.

      저장소 권한도 선언하지 않는다. 이미지는 시스템 사진 선택기(Photo Picker)로 고르며,
      사용자가 고른 한 장만 시스템이 넘겨주므로 권한이 필요 없다.

      INTERNET 도 선언하지 않는다. 이 앱은 네트워크 호출을 하지 않는다.
      홈 광고 지면은 레이아웃·코드만 있고 BuildConfig.ADS_ENABLED=false 로 꺼져 있으며,
      광고 SDK 는 의존성에서 빠져 있다(app/build.gradle.kts 참고).

      알림 접근은 앱이 요청할 수 없고 사용자가 시스템 설정에서 직접 켜야 한다.
      켠 뒤에도 앱 안에서 허용한 패키지의 알림만 내용을 읽는다
      (PaymentNotificationListener 참고).
    -->

    <!--
      ML Kit(한국어 OCR)이 매니페스트 병합으로 끌고 들어오는 네트워크 권한을 도로 뺀다.
      한국어 인식 모델은 APK 에 통째로 들어 있어(약 39MB) 오프라인으로 동작하므로
      인터넷이 필요 없다. 선언만 남으면 "네트워크 요청을 하지 않는다"는 개인정보 고지가
      거짓이 되고, 알림 접근 심사에서 해명할 거리만 늘어난다.

      제거 후 이미지 불러오기가 실기기에서 실제로 동작하는지 반드시 확인할 것.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!--
      알림을 띄운 앱의 표시 이름을 얻고 기본 문자 앱을 식별하기 위한 패키지 가시성(Android 11+).
      QUERY_ALL_PACKAGES 는 쓰지 않는다 — 필요한 앱만 명시한다.
      목록에 없는 앱은 이름 대신 패키지명으로 표시될 뿐, 수집 동작에는 지장이 없다.
    -->
    <queries>
        <!-- 기본 문자 앱(제조사마다 다르므로 인텐트로 찾는다) -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>

        <package android:name="com.kakao.talk" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.android.messaging" />
        <package android:name="com.android.mms" />
        <package android:name="com.shcard.smartpay" />
        <package android:name="com.hyundaicard.appcard" />
        <package android:name="kr.co.samsungcard.mpocket" />
        <package android:name="net.ib.android.smcard" />
        <package android:name="com.kbcard.cxh.appcard" />
        <package android:name="com.kbcard.kbbusinesscard" />
        <package android:name="com.lcacApp" />
        <package android:name="com.wooricard.smartapp" />
        <package android:name="com.hanaskcard.paycla" />
        <package android:name="com.bccard.mobilecard" />
        <package android:name="com.bccard.bcsmartapp" />
        <package android:name="kvp.jjy.MispAndroid320" />
        <package android:name="nh.smart.banking" />
        <package android:name="nh.smart.nhallonepay" />
        <package android:name="nh.smart.card" />
        <package android:name="com.kakaopay.app" />
        <package android:name="viva.republica.toss" />
    </queries>

    <application
        android:name=".DulSsenCardApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.DulSsenCard"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DulSsenCard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          유일한 수집 경로.
          BIND_NOTIFICATION_LISTENER_SERVICE 는 시스템만 바인딩할 수 있는 서명 권한이다.
        -->
        <service
            android:name=".notification.PaymentNotificationListener"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
